       </property>
       <property name="toolTip">
        <string>Minimum confidence for a message to be reported.
Confidence combines how character-like each shape is with how consistently the characters line up as a message.</string>
       </property>
       <property name="text">
        <string>Confidence Threshold</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QSlider" name="confidenceSlider">
       <property name="toolTip">
        <string>Minimum confidence (0-100%) for a message to be reported.
• Default: 50%
• Lower values (30-45%): Report weaker candidates (more detections, more false positives)
• Medium values (45-60%): Balanced (recommended for most searches)
• Higher values (60-80%): Only report rows of clearly formed characters (fewer false positives)
Single characters (e.g. an X) score lower than multi-character messages, so very high thresholds report words only.</string>
       </property>
       <property name="minimum">
        <number>0</number>
       </property>
       <property name="maximum">
        <number>100</number>
       </property>
       <property name="pageStep">
        <number>5</number>
       </property>
       <property name="value">
        <number>50</number>
       </property>
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="tickPosition">
        <enum>QSlider::TicksBelow</enum>
       </property>
       <property name="tickInterval">
        <number>10</number>
